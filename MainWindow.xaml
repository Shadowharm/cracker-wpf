<Window x:Class="Cracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cracker"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="800" Style="{StaticResource WindowStyle}"
        Loaded="Window_Loaded" ContentRendered="MainFrame_ContentRendered">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" 
            Background="#F8F9FA" 
            BorderBrush="#E1E4E8" 
            BorderThickness="0,0,0,1"
            Padding="20,15">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <TextBlock Grid.Column="0" 
                   Name="txtCapt" 
                   FontSize="28" 
                   Text="{Binding Title}" 
                   VerticalAlignment="Center" 
                   FontWeight="Bold" 
                   TextWrapping="Wrap"
                   Foreground="#2C3E50"/>

        <StackPanel Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right">
          <Button Name="btnBack" 
                  Content="Назад" 
                  Width="120" 
                  Margin="0,0,10,0" 
                  Visibility="{Binding BackButtonVisibility}" 
                  Command="{Binding BackCommand}"/>
          <Button Name="btnExit" 
                  Content="Выйти" 
                  Width="120" 
                  Visibility="{Binding ExitButtonVisibility}" 
                  Command="{Binding ExitCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Frame Name="MainFrame" 
           NavigationUIVisibility="Hidden" 
           Grid.Row="1" 
           Grid.ColumnSpan="2"
           ContentRendered="MainFrame_ContentRendered"/>
  </Grid>
</Window>
