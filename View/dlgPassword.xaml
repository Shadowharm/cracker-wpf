<Window x:Class="Cracker.dlgPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Cracker"
        mc:Ignorable="d"
        Title="Пароль" Height="170" Width="400" Style="{StaticResource WindowStyle}">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="30"/>
      <RowDefinition Height="30"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Column="0" Grid.Row="0" Text="Введите пароль:"/>
    <PasswordBox Grid.Column="1" Grid.Row="0" Name="pbPass" Height="30" VerticalContentAlignment="Center"/>
    <TextBlock Grid.Column="0" Grid.Row="1" Text="Повторите ввод:"/>
    <PasswordBox Grid.Column="1" Grid.Row="1" Name="pbConfirm" VerticalContentAlignment="Center"/>
    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3" 
                Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button Content="Отмена" Click="Cancel_Click"/>
      <Button Content="ОК" Click="Ok_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>