<Page x:Class="Cracker.pgUsers"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cracker"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" Title="Пользователи" Loaded="Page_Loaded">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal">
      <Button Name="btnAdd" Content="Добавить" Command="{Binding AddCommand}"/>
      <Button Name="btnRemove" Content="Удалить" Command="{Binding RemoveCommand}"/>
    </StackPanel>

    <DataGrid x:Name="grdUsers" Grid.Row="1" IsReadOnly="False" 
              ItemsSource="{Binding Users}"
              SelectedItem="{Binding SelectedUser}"
              CellEditEnding="grdCellEditEnd">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding name}" Header="Пользователь" Width="*"/>
        <DataGridTemplateColumn Header="Роль" Width="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding role}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox SelectedValue="{Binding role, UpdateSourceTrigger=PropertyChanged}"
                       ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=Page}}"
                       DisplayMemberPath="RoleDef"
                       SelectedValuePath="Code"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding login}" Header="Имя входа" Width="*"/>
        <DataGridTemplateColumn Width="200" Header="Пароль">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Задать" Height="20" 
                      Command="{Binding DataContext.SetPasswordCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                      CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>
