<Page x:Class="Cracker.pgNote"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cracker"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Комментарии к " Loaded="Page_Loaded">

  <Page.Resources>
    <local:DateToStrConv x:Key="pgDTSC"/>
    
    <Style x:Key="ChatMessageStyle" TargetType="Border">
      <Setter Property="Background" Value="#2D2D30"/>
      <Setter Property="BorderBrush" Value="#3F3F46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="8,4"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    
    <Style x:Key="TimeTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A0A0A0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    
    <Style x:Key="AuthorTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#4EC9B0"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    
    <Style x:Key="MessageTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D4D4D4"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Page.Resources>

  <Grid Background="#1E1E1E">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="scrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" Padding="10">
      <ItemsControl x:Name="itemsControl" ItemsSource="{Binding Notes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource ChatMessageStyle}">
              <StackPanel>
                <TextBlock Text="{Binding created,Converter={StaticResource pgDTSC},ConverterParameter=datetime}" 
                          Style="{StaticResource TimeTextStyle}"/>
                <TextBlock Text="{Binding user}" Style="{StaticResource AuthorTextStyle}"/>
                <TextBlock Text="{Binding note}" Style="{StaticResource MessageTextStyle}"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,0,0" Padding="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBox x:Name="txtNewComment" Grid.Row="0" Grid.Column="0" 
                 Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"
                 MinHeight="60" MaxHeight="120"
                 AcceptsReturn="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="8"
                 FontSize="14"
                 Background="#3C3C3C"
                 Foreground="#D4D4D4"
                 BorderBrush="#3F3F46"
                 KeyDown="txtNewComment_KeyDown"/>
        
        <Button Name="btnSend" Grid.Row="0" Grid.Column="1" 
                Content="Отправить" 
                Command="{Binding SendCommand}"
                Width="100" Height="60"
                Margin="10,0,0,0"
                Padding="10,5"
                FontSize="14"
                Background="#0E639C"
                Foreground="White"
                BorderBrush="#1177BB"
                Cursor="Hand"/>
      </Grid>
    </Border>
  </Grid>
</Page>
