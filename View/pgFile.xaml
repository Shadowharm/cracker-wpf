<Page x:Class="Cracker.pgFile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cracker"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Файлы заказа " Loaded="Page_Loaded">

  <Page.Resources>
    <local:DateToStrConv x:Key="pgDSC"/>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <Button Name="btnAdd" Content="Добавить" Click="btnAdd_Click"/>
      <Button Name="btnRemove" Content="Удалить" Click="btnRemove_Click"/>
    </StackPanel>

    <DataGrid x:Name="grdFile" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="False" 
                  CellEditEnding="grdCellEditEnd" PreviewKeyDown="grdKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding name}" Header="Имя" Width="*"/>
        <DataGridTextColumn Binding="{Binding size}" Header="Размер" Width="100"/>
        <DataGridTextColumn Binding="{Binding link}" Header="Ссылка" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>

