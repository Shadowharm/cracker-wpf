<Page x:Class="Cracker.pgProjects"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cracker"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Проекты" Loaded="Page_Loaded">

  <Page.Resources>
    <local:DateToStrConv x:Key="pgDTSC"/>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="250"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
      <Button Name="btnAdd" Content="Добавить" Command="{Binding AddCommand}"/>
      <Button Name="btnRemove" Content="Удалить" Command="{Binding RemoveCommand}"/>
      <Button Name="btnSave" Content="Сохранить" Command="{Binding SaveCommand}"/>
    </StackPanel>

    <DataGrid x:Name="grdProjects" Grid.Row="1" Grid.Column="0" IsReadOnly="False" 
              ItemsSource="{Binding Projects}"
              SelectedItem="{Binding SelectedProject}"
              CellEditEnding="grdCellEditEnd" PreviewKeyDown="grdKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding name}" Header="Проект" Width="*"/>
      </DataGrid.Columns>
    </DataGrid>

    <GridSplitter Grid.Column="1" Grid.Row="1"
                  Width="3"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  ResizeDirection="Columns"
                  Background="Gray"/>

    <DockPanel Grid.Row="1" Grid.Column="2">
      <TextBox Text="Описание" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsReadOnly="True" DockPanel.Dock="Top"
              Background="#212b27" Foreground="#D4D4D4" />
      <TextBox Name="txtDesc" Text="{Binding SelectedProject.description, UpdateSourceTrigger=PropertyChanged}"
             AcceptsTab="True" AcceptsReturn="True" VerticalAlignment="Stretch"/>
    </DockPanel>
  </Grid>
</Page>
