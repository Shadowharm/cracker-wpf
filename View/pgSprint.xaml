<Page x:Class="Cracker.pgSprint"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Cracker"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Спринты" Loaded="Page_Loaded">

  <Page.Resources>
    <local:DateToStrConv x:Key="pgDSC"/>
  </Page.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <Button Name="btnAdd" Content="Добавить" Command="{Binding AddCommand}"/>
      <Button Name="btnRemove" Content="Удалить" Command="{Binding RemoveCommand}"/>
    </StackPanel>

    <DataGrid x:Name="grdSprint" Grid.Row="1" Grid.ColumnSpan="2" IsReadOnly="False" 
              ItemsSource="{Binding Sprints}"
              SelectedItem="{Binding SelectedSprint}"
              CellEditEnding="grdCellEditEnd" PreviewKeyDown="grdKeyDown">
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding name}" Header="Название" Width="*"/>
        <DataGridTextColumn Binding="{Binding start_time,Converter={StaticResource pgDSC}}" Header="Начало" Width="100"/>
        <DataGridTextColumn Binding="{Binding end_time,Converter={StaticResource pgDSC}}" Header="Окончание" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Page>
